---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Latest posts — fake frontend" active="latest">
  <section class="section" id="latest">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="kicker">The writing</span>
          <h2>Latest posts</h2>
          <p class="desc">
            Everything published so far — new guides land most weeks.
          </p>
        </div>
        <a class="btn btn-text" href="/rss.xml"
          >RSS feed <span class="arr">→</span></a
        >
      </div>
      <PostList posts={posts} />
    </div>
  </section>
</BaseLayout>
