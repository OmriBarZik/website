---
// MDX-facing wrapper. Reads the code from children and hands it to the
// Svelte island, which hydrates when scrolled into view.
//
//   <Sandbox filename="env.ts" lang="ts">{`
//     const port = Number(process.env.PORT ?? 8080);
//     console.log("port:", port);
//   `}</Sandbox>
import SandboxIsland from './Sandbox.svelte';
import { decodeEntities } from '../utils/text';

interface Props {
	filename?: string;
	lang?: 'ts' | 'js';
	badge?: string;
}
const { filename = 'index.js', lang = 'js', badge } = Astro.props;
const resolvedBadge = badge ?? (lang === 'ts' ? 'TS' : 'Node');

// slot render returns HTML-escaped text; decode back to raw source, dedent.
const raw = decodeEntities(await Astro.slots.render('default'))
	.replace(/^\n/, '')
	.replace(/\s+$/, '');
const dedent = (() => {
	const lines = raw.split('\n');
	const indents = lines.filter((l) => l.trim()).map((l) => l.match(/^ */)![0].length);
	const n = indents.length ? Math.min(...indents) : 0;
	return n > 0 ? lines.map((l) => l.slice(n)).join('\n') : raw;
})();
---

<SandboxIsland
	client:visible
	filename={filename}
	lang={lang}
	badge={resolvedBadge}
	code={dedent}
/>
