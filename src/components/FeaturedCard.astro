---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { mdInline } from '../utils/text';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, topic, readingTime, heroImage } =
  post.data;
---

<a class="feat-card" href={`/blog/${post.id}/`} aria-label="Latest post">
  {
    heroImage ? (
      <Image src={heroImage} alt="" width={640} height={400} />
    ) : (
      <div class="ph" />
    )
  }
  <div class="body">
    <div class="eyebrow">
      ★ Latest&nbsp;&nbsp;·&nbsp;&nbsp;<span class="topic">{topic}</span>
    </div>
    <h3 class="t-title">{title}</h3>
    <p set:html={mdInline(description)} />
    <div class="meta">
      <span><FormattedDate date={pubDate} /></span>
      <span>· {readingTime} read</span>
    </div>
  </div>
</a>

<style>
  .feat-card {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-200);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition:
      transform var(--duration-normal) var(--ease),
      box-shadow var(--duration-normal) var(--ease);

    &:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-lg);
    }

    /* :global(img) — the cover is an <Image> child component */
    .ph,
    :global(img) {
      aspect-ratio: 16 / 10;
      width: 100%;
      object-fit: cover;
    }
  }

  .body {
    padding: var(--space-250) var(--space-300) var(--space-300);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-100);
    font-family: var(--label);
    font-size: var(--fs-2xs);
    letter-spacing: var(--tracking-wide);
    color: var(--primary);
    font-weight: var(--weight-semibold);
    white-space: nowrap;

    .topic {
      color: var(--text-muted);
    }
  }

  /* font style via .t-title; keep layout only */
  h3 {
    margin: var(--space-150) 0 0;
  }

  p {
    color: var(--text-muted);
    font-size: var(--fs-base);
    margin: var(--space-100) 0 0;
  }

  .meta {
    font-family: var(--mono);
    font-size: var(--fs-2xs);
    color: var(--text-faint);
    margin-top: var(--space-200);
    display: flex;
    gap: var(--space-200);
  }

  @media (prefers-reduced-motion: reduce) {
    .feat-card:hover {
      transform: none;
    }
  }
</style>
