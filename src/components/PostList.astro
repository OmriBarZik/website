---
import type { CollectionEntry } from 'astro:content';
import PostListIsland from './PostList.svelte';
import { TOPICS } from '../consts';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;

const topicClass = (topic: string) =>
  topic === 'TypeScript'
    ? 'is-ts'
    : topic === 'Docker'
      ? 'is-docker'
      : 'is-node';
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-us', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });

const data = posts.map((p) => ({
  href: `/blog/${p.id}/`,
  title: p.data.title,
  topic: p.data.topic,
  topicClass: topicClass(p.data.topic),
  readingTime: p.data.readingTime,
  date: fmtDate(p.data.pubDate),
}));
---

<PostListIsland client:visible posts={data} topics={[...TOPICS]} />
