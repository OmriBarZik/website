---
import type { CollectionEntry } from 'astro:content';
import PostListIsland from './PostList.svelte';
import { TOPICS } from '../consts';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;

const topicClass = (topic: string) => {
  return topic === 'TypeScript'
    ? 'is-ts'
    : topic === 'Docker'
      ? 'is-docker'
      : 'is-node';
};

const fmtDate = (date: Date) => {
  return date.toLocaleDateString('en-us', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};

const data = posts.map((post) => ({
  href: `/blog/${post.id}/`,
  title: post.data.title,
  topic: post.data.topic,
  topicClass: topicClass(post.data.topic),
  readingTime: post.data.readingTime,
  date: fmtDate(post.data.pubDate),
}));
---

<PostListIsland client:visible posts={data} topics={[...TOPICS]} />
