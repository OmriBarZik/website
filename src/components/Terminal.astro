---
// MDX-facing wrapper for the simulated container terminal. Scripted responses
// keyed by command — WebContainers is NOT Docker, so Docker output is
// illustrative. Hydrates as a Svelte island when scrolled into view.
import TerminalIsland from './Terminal.svelte';

interface Props {
  prompt?: string;
  title?: string;
  hint?: string;
  intro?: string[];
  demo?: string;
  commands?: Record<string, string[]>;
}
const {
  prompt = '~ $',
  title = 'terminal',
  hint = 'help',
  intro,
  demo,
  commands,
} = Astro.props;
---

<TerminalIsland
  client:visible
  prompt={prompt}
  title={title}
  hint={hint}
  intro={intro}
  demo={demo}
  commands={commands}
/>
