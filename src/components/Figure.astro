---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Prose figure — real <Image> when a src is supplied, otherwise a warm
// placeholder block (matching the prototype's drop-zone fallback).
interface Props {
  src?: ImageMetadata;
  alt?: string;
  caption?: string;
  /** aspect ratio for the placeholder fallback: 16/8 · 16/9 · 21/9 · 4/3 · 1/1 */
  ratio?: string;
}
const { src, alt = '', caption, ratio = '16/8' } = Astro.props;
// map the ratio to a CSS class (no inline styles, for a strict CSP)
const ratioClass = `r-${ratio.replace('/', '-')}`;
---

<figure>
  {
    src ? (
      <Image src={src} alt={alt} />
    ) : (
      <div class:list={['ph', ratioClass]} />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>
